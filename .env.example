# Black Number — configuration. Copy to .env and fill in what you use.
# Nothing here is required. With no keys at all the assistant runs on an offline
# deterministic brain with typed input, and every skill still works.

# ── Brain (reasoning) ────────────────────────────────────────────────────────
# Which provider drives reasoning: anthropic | ollama | offline
BN_BRAIN=anthropic
ANTHROPIC_API_KEY=
BN_ANTHROPIC_MODEL=claude-opus-5
# Reasoning depth: low | medium | high | xhigh | max.
# `high` is the API default and the right choice for correctness. Dropping to
# medium or low makes routine voice commands noticeably snappier.
BN_EFFORT=high
# For the local option (no key, no network):
BN_OLLAMA_HOST=http://localhost:11434
BN_OLLAMA_MODEL=llama3.1:8b

# ── Speech ───────────────────────────────────────────────────────────────────
# Input:  macos | whisper | text     Output: macos_say | none
BN_STT=text
BN_TTS=macos_say
BN_VOICE=Daniel
BN_WAKE_WORD=black number

# ── Persona ──────────────────────────────────────────────────────────────────
# How it addresses you. Empty by default, because most people find an honorific
# grating. Set it to "sir", "boss", your name — whatever you want to hear.
BN_ADDRESS=
# Your city, so "what's the weather" needs no argument. Left empty, the weather
# service geolocates by IP address instead.
BN_CITY=

# ── Tools ────────────────────────────────────────────────────────────────────
# Preferred editor for `open_in_editor`. Falls back to code, cursor, subl, zed,
# then the system default.
BN_EDITOR=

# ── Safety ───────────────────────────────────────────────────────────────────
# Confirmation policy for risky actions: always | trusted | never
# 'trusted' runs read-only actions freely and confirms anything that changes
# state. 'never' confirms nothing and warns loudly at startup — the security
# skill's authorization prompt is the one thing it cannot switch off.
BN_CONFIRM=trusted
