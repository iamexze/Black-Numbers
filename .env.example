# Black Number — configuration. Copy to .env and fill what you use.
# Nothing here is required to run: with no keys, the assistant falls back to
# an offline deterministic brain and text input, and every skill still works.

# ── Brain (reasoning) ────────────────────────────────────────────────────────
# Which provider drives reasoning: anthropic | ollama | offline
BN_BRAIN=anthropic
ANTHROPIC_API_KEY=
BN_ANTHROPIC_MODEL=claude-opus-4-8
# For the local option:
BN_OLLAMA_HOST=http://localhost:11434
BN_OLLAMA_MODEL=llama3.1:8b

# ── Speech ───────────────────────────────────────────────────────────────────
# Input:  macos | whisper | text     Output: macos_say | none
BN_STT=text
BN_TTS=macos_say
BN_VOICE=Daniel
BN_WAKE_WORD=black number

# ── Safety ───────────────────────────────────────────────────────────────────
# Confirmation policy for risky actions: always | trusted | never
# 'trusted' auto-runs only allowlisted read-only actions; everything else asks.
BN_CONFIRM=trusted
